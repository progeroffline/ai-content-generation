# Read into the process environment; never commit the real password.
STUDIO_PASSWORD=
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8090

# Set only on the control-panel server. Never expose these values in browser code.
VAST_API_KEY=
# Hash printed by scripts/vast/create_template.py (SwarmUI with studio provisioning).
VAST_TEMPLATE_ID=
VAST_IMAGE=vastai/swarmui
# Needed by create_template.py for Civitai models in scripts/vast/models.txt.
CIVITAI_TOKEN=

# Required only by docker-compose.production.yml for automatic HTTPS.
STUDIO_DOMAIN=studio.example.com

# Log verbosity: DEBUG (full request/response bodies), INFO, WARNING.
STUDIO_LOG_LEVEL=INFO
