# Read into the process environment; never commit the real password.
STUDIO_PASSWORD=
STUDIO_DATA=/workspace/studio-data
COMFY_URL=http://127.0.0.1:18188
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8090

# Set only on the control-panel server. Never expose these values in browser code.
VAST_API_KEY=
VAST_TEMPLATE_ID=
VAST_IMAGE=vastai/comfy:@vastai-automatic-tag

# Optional Authorization header for a protected remote ComfyUI endpoint.
# Leave COMFY_URL empty to follow the running Vast instance automatically.
# Example: Bearer <token> or Basic <base64-user-password>
COMFY_AUTHORIZATION=

# Required only by docker-compose.production.yml for automatic HTTPS.
STUDIO_DOMAIN=studio.example.com

# Log verbosity: DEBUG (full request/response bodies), INFO, WARNING.
STUDIO_LOG_LEVEL=INFO
